# Kawach AI engine — GCP / Vertex production
DATABASE_URL=postgresql+asyncpg://USER:PASS@/kawach_ai?host=/cloudsql/kavach-care:asia-south1:INSTANCE
KAWACH_API_SECRET=change-me

LLM_PROVIDER=vertex
GCP_PROJECT_ID=kavach-care
