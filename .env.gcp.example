# Kawach AI engine — GCP / Vertex production
DATABASE_URL=postgresql+asyncpg://USER:PASS@/kawach_ai?host=/cloudsql/kavach-care:asia-south1:INSTANCE
KAWACH_API_SECRET=change-me

LLM_PROVIDER=vertex
GCP_PROJECT_ID=kavach-care
GCP_REGION=asia-south1
# Chat/companion model location (Pro allowlist often requires global; Flash works in asia-south1)
VERTEX_LOCATION=global
VERTEX_CHAT_MODEL=gemini-3.5-pro
VERTEX_CAREGIVER_CHAT_MODEL=gemini-3.5-pro
VERTEX_EMBEDDING_MODEL=text-multilingual-embedding-002
EMBED_DIM=768

DEBUG=false
CORS_ORIGINS=*
