VERTEX_LOCATION=global
VERTEX_CHAT_MODEL=gemini-3.1-pro-preview
VERTEX_CAREGIVER_CHAT_MODEL=gemini-3.1-pro-preview
VERTEX_EMBEDDING_MODEL=text-multilingual-embedding-002
EMBED_DIM=768

DEBUG=false
CORS_ORIGINS=*
