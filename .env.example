# Local Docker Postgres (`docker compose up -d db`)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/kawach_ai

# Auth — kavach-backend sends this on /v1/* routes
KAWACH_API_SECRET=dev-secret

HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=*

# LLM provider: azure | ollama | xai
LLM_PROVIDER=ollama

# Azure AI Foundry (embeddings + optional chat fallback)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://<foundry-resource>.openai.azure.com/openai/v1/
AZURE_CHAT_DEPLOYMENT=Phi-4-mini-instruct
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_MODEL=text-embedding-3-small

# Self-hosted Gemma on Azure Container Apps (Ollama, OpenAI-compatible)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Legacy xAI fallback (optional)
# XAI_API_KEY=xai-...
# GROK_CHAT_MODEL=grok-3-mini

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=8
