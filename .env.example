# Local Docker Postgres (`docker compose up -d db`)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/kawach_ai

# Grok / xAI — https://console.x.ai/
XAI_API_KEY=xai-...
GROK_CHAT_MODEL=grok-3-mini
GROK_EMBEDDING_MODEL=text-embedding-3-large

# Optional embeddings fallback
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chat falls back to Grok CLI if XAI_API_KEY unset (`grok login`)
GROK_CLI_TIMEOUT_SECONDS=120

# Auth — kavach-backend-api sends this on /v1/* routes
KAWACH_API_SECRET=dev-secret

HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=*

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=8
